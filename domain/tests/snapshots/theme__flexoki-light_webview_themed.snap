---
source: domain/tests/theme.rs
expression: "theme.webview_css(BodyStyle::Themed)"
---
html,body{height:max-content!important;min-height:0!important;max-height:none!important}
:root{color-scheme:light}
:root{--sealwax-quote-fill:rgba(16, 15, 15, 0.1);--sealwax-quote-text:#4c4a47}
html{background-color:#fffcf0;color:#100f0f;font:15px/1.55 "Adwaita Sans", sans-serif;font-weight:500}
body{margin:0;padding:0;overflow-wrap:anywhere;max-width:70ch}
a{color:#205ea6!important}
blockquote{margin:0 0 0 2px;padding-left:12px;border-left:3px solid #c8c6bd;color:#4c4a47}
pre,code,kbd,samp,tt{font-family:"JetBrainsMono Nerd Font", monospace;font-size:13px}
pre{white-space:pre-wrap}
hr{border:0;border-top:1px solid #c8c6bd}
img{max-width:100%;height:auto}
table{border-collapse:collapse}
td,th{border-color:#c8c6bd}
::selection{background-color:rgba(16, 15, 15, 0.35)}
