# Maintainer: Pronto contributors
# Generated from packaging/PKGBUILD.in by tools/package-source.py, which fills in the version,
# the source checksum, SOURCE_DATE_EPOCH (the time of the packaged commit) and the Microsoft
# client ID to build in.
# Pronto replaces dispatchy, its pre-release name; upstream Sealwax stays separate.
pkgname=pronto
conflicts=('dispatchy')
replaces=('dispatchy')
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Fast, minimal email client for Omarchy"
arch=('x86_64')
license=('MIT')
depends=('gtk4' 'libadwaita' 'webkitgtk-6.0' 'sqlite>=3.43' 'glib2' 'gcc-libs' 'glibc' 'adwaita-fonts')
optdepends=(
  'gnome-keyring: a Secret Service that keeps passwords and sign-in tokens'
  'hunspell: spell checking in the composer, with a dictionary such as hunspell-en_us'
  'hunspell-en_us: an English dictionary for spell checking (other hunspell dictionaries work too)'
)
makedepends=('rust' 'cargo' 'pkgconf')
# The release profile carries no debug info, so a -debug package would be empty. makepkg's LTO
# flags would compile ring's C code to GCC LTO bytecode, which Rust's linker (rust-lld) can't read.
options=('!debug' '!lto')
source=("pronto-${pkgver}.tar.gz")
sha256sums=('@SHA256@')
export SOURCE_DATE_EPOCH=@SOURCE_DATE_EPOCH@
# Sign in with Microsoft's client ID, built in so users need no registration of their own (a
# public client's ID, not a secret; config.toml's client_id wins over it). Empty: none built in.
_microsoft_client_id='@MICROSOFT_CLIENT_ID@'

# The binary's panic locations name the files they're in: the build's folder, Cargo's registry
# and, with rustup, the toolchain's copy of the standard library, the last two under the
# builder's home. All are mapped to fixed names, so the package holds no path of the machine
# that built it (makepkg: "Package contains reference to $srcdir").
_remap_paths() {
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/pronto \
--remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/usr/src/cargo \
--remap-path-prefix=$(rustc --print sysroot)=/usr/src/rust"
}

prepare() {
  cd "$srcdir/pronto-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$srcdir/pronto-$pkgver"
  _remap_paths
  if [[ -n $_microsoft_client_id ]]; then
    export PRONTO_MICROSOFT_CLIENT_ID=$_microsoft_client_id
  fi
  cargo build --release --locked --offline -p pronto
}

check() {
  cd "$srcdir/pronto-$pkgver"
  _remap_paths
  # Only the crates without GTK: a clean build has no display for the app's self-tests.
  cargo test --locked --offline -p sealwax-domain -p sealwax-infrastructure -p sealwax-engine
}

package() {
  cd "$srcdir/pronto-$pkgver"
  install -Dm755 target/release/pronto "$pkgdir/usr/bin/pronto"
  install -Dm644 packaging/io.github.omarsimon1.Pronto.desktop \
    "$pkgdir/usr/share/applications/io.github.omarsimon1.Pronto.desktop"
  # D-Bus activation: launchers activate Pronto over D-Bus (DBusActivatable=true), and a
  # command line with no Pronto running asks the bus to start it.
  install -Dm644 packaging/io.github.omarsimon1.Pronto.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.omarsimon1.Pronto.service"
  # The approved pixel-grid icon: crisp PNGs from 16 to 512 px and the unchanged master SVG
  # (generated by tools/make-icons.py from docs/brand/pronto-icon.svg).
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/hicolor/${size}x$size/apps/io.github.omarsimon1.Pronto.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x$size/apps/io.github.omarsimon1.Pronto.png"
  done
  install -Dm644 packaging/icons/hicolor/scalable/apps/io.github.omarsimon1.Pronto.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.omarsimon1.Pronto.svg"
  install -Dm644 packaging/io.github.omarsimon1.Pronto.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.omarsimon1.Pronto.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/pronto/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/pronto/README.md"
  install -Dm644 docs/INTEGRATIONS.md "$pkgdir/usr/share/doc/pronto/INTEGRATIONS.md"
  install -Dm644 docs/AI.md "$pkgdir/usr/share/doc/pronto/AI.md"
  install -Dm644 docs/USER_GUIDE.md "$pkgdir/usr/share/doc/pronto/USER_GUIDE.md"
  install -Dm644 INSTALL.md "$pkgdir/usr/share/doc/pronto/INSTALL.md"
  install -Dm644 FORK.md "$pkgdir/usr/share/doc/pronto/FORK.md"
}
