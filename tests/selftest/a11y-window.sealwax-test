# The accessibility pass (M9, ML-092) on the main window at its three layouts, on a fixture
# store: every control on screen has an accessible name, a role that says what it is and the
# states its role needs (assert-accessible, app/src/selftest/a11y.rs), and Tab and Shift+Tab
# (real key presses through Broadway) go through the panes left to right and come back where
# they started: folders, then the list's bar and the list, then the reader's toolbar and the
# conversation, also with no message open. The folder list and the message list are one Tab
# stop each (Up and Down move inside them). In the harness's Split with the sidebar shown
# (focused.sealwax-test has the Focused layout's). Every message is fictional.
# Run: tools/headless.sh 71 target/debug/pronto --self-test tests/selftest/a11y-window.sealwax-test

desktop tiling
fixtures --count 40 --seed 9 --folders spread
resize 1440 900
triage-mark-read-on-open false
list-wait
list-select 0
wait-until assert-reader-page message

# Wide: sidebar · list · reader.
assert-layout wide
assert-accessible window
assert-accessible-name compose "New message"
assert-accessible-role folder-list list
assert-accessible-name folder-list Folders
assert-accessible-name message-list Messages
assert-accessible-name list-search "Search mail"
assert-accessible-role list-sidebar toggle-button
assert-accessible-name list-sidebar Sidebar
assert-accessible-state list-sidebar pressed true
assert-accessible-name list-search-button Search
assert-accessible-name list-compose "New message"
assert-accessible-name list-menu "Main menu"
assert-accessible-name reader-archive Archive
assert-accessible-state reader-previous disabled true

# Tab from the folder shown: the sidebar's footer, the list's bar (the sidebar button, search,
# compose, the menu), the list, the reader's toolbar and conversation, and round to the
# sidebar's compose button and the folder list again.
focus folder:folder-1
assert-focus folder:folder-1
tab-chain window forward 80
assert-tab-chain folder:folder-1,config,list-sidebar,list-search-button,list-compose,list-menu,message-list,reader-archive,reader-next,reader-subject,quick-reply-text,compose,folder:folder-1
tab-chain window backward 80
assert-tab-chain folder:folder-1,compose,quick-reply-text,reader-subject,reader-next,reader-archive,message-list,list-menu,list-compose,list-search-button,list-sidebar,config,folder:folder-1

# With no message open the reader's toolbar hides (the Superhuman pass), so Tab goes from the
# list on to the sidebar and Shift+Tab round the start comes back to the list (2026-10-08: the
# reader's empty page once took the press and kept the focus on Next for good): with messages
# but none selected, and in an empty folder, whose list is no stop and shows alone.
folder sent
folder inbox
list-wait
assert-list-selected none
assert-reader-page empty
focus folder:folder-1
tab-chain window forward 80
assert-tab-chain folder:folder-1,config,list-sidebar,list-search-button,list-compose,list-menu,message-list,compose,folder:folder-1
tab-chain window backward 80
assert-tab-chain folder:folder-1,compose,message-list,list-menu,list-compose,list-search-button,list-sidebar,config,folder:folder-1
focus list
tab-chain window forward 80
assert-tab-chain message-list,compose,folder:folder-1,config,list-sidebar,list-search-button,list-compose,list-menu,message-list
tab-chain window backward 80
assert-tab-chain message-list,list-menu,list-compose,list-search-button,list-sidebar,config,folder:folder-1,compose,message-list
folder trash
list-wait
assert-list-empty "No messages"
assert-reader-page empty
assert-shown reader false
focus folder:folder-6
tab-chain window forward 80
assert-tab-chain folder:folder-6,config,list-sidebar,list-search-button,list-compose,list-menu,compose,folder:folder-6
tab-chain window backward 80
assert-tab-chain folder:folder-6,compose,list-menu,list-compose,list-search-button,list-sidebar,config,folder:folder-6
folder inbox
list-wait
list-select 0
wait-until assert-reader-page message

# The folder list is one stop: Tab leaves it from any row, and comes back to the folder shown.
focus folder:folder-1
key Down
key Down
key Tab
assert-focus config
key <Shift>Tab
assert-focus folder:folder-1
key <Shift>Tab
assert-focus compose
key Tab
assert-focus folder:folder-1

# The message list is one stop too: Down moves the selection, Tab goes to the reader.
focus list
key Tab
assert-focus reader-archive
key <Shift>Tab
assert-focus list

# Where the focus lands after a message leaves: where it was (the list, the next message's
# body, the toolbar button), and after Move to… closes.
focus list
key e
assert-focus list
list-select 0
wait-until assert-reader-page message
focus reader
key e
wait-until assert-reader-page message
assert-focus reader
focus reader
key Delete
wait-until assert-reader-page message
assert-focus reader
focus reader-archive
key Return
assert-focus reader-archive
focus list
key v
assert-move-to open true
key Down
key Return
assert-move-to open false
assert-focus list
focus reader-move-to
key Return
assert-move-to open true
key Return
assert-move-to open false
assert-focus reader-move-to

# Menus and the folder menu.
menu-open list-menu
assert-accessible window
menu-close list-menu
menu-open reader-more
assert-accessible window
menu-close reader-more
sidebar-menu inbox
assert-accessible window
key Escape
assert-sidebar-menu closed

# The folder tree (M9): subfolders indented under their folder with their levels, a parent's
# expanded state, folded and open; the folder menu's New Subfolder, Rename and Delete Folder,
# and the account heading's New Folder.
folder-add Fixtures INBOX/Kvitteringer
folder-add Fixtures INBOX/Kvitteringer/2026
assert-folder-level Fixtures:INBOX/Kvitteringer/2026 3
assert-folder-expanded Fixtures:INBOX/Kvitteringer true
assert-accessible window
folder-arrow Fixtures:INBOX/Kvitteringer
assert-folder-expanded Fixtures:INBOX/Kvitteringer false
assert-accessible window
folder-arrow Fixtures:INBOX/Kvitteringer
sidebar-menu Fixtures:INBOX/Kvitteringer
assert-shown folder-menu-rename true
assert-accessible window
key Escape
account-menu account-1
assert-shown account-menu-new-folder true
assert-accessible window
key Escape
assert-sidebar-menu closed

# The message row's menu (M9, ADR-020): from Menu on the row under the cursor, named items and
# the reason a rules item doesn't apply to a fixture's account (no rules file); Escape gives the
# list the focus back.
list-select 0
focus list
key Menu
assert-row-menu open
assert-accessible window
assert-accessible-name message-menu-archive Archive
assert-tooltip message-menu-junk-sender "Only accounts set up in Pronto have rules"
key Escape
assert-row-menu closed
assert-focus list

# The select mode: checkboxes on the rows, the batch page in the reader.
focus list
key x
assert-select-mode true
key j
key x
assert-reader-page batch
assert-accessible window
key Escape
assert-select-mode false

# Medium: list · reader, the sidebar hidden, with a message shown and the toasts of the steps
# above gone.
resize 1100 900
assert-layout medium
setup-dismiss-toasts
list-select 0
wait-until assert-reader-page message
# The pane shows "message" while the conversation is still laid out unseen; Tab would pass it.
wait-until assert-reader-selected
assert-accessible window
focus list
tab-chain window forward 80
assert-tab-chain message-list,reader-archive,quick-reply-text,list-sidebar,list-search-button,list-compose,list-menu,message-list

# Narrow: one pane at a time, with the sidebar over the list and Back in the reader.
resize 800 900
assert-layout narrow
assert-accessible window
focus list
tab-chain window forward 40
assert-tab-chain message-list,list-sidebar,list-search-button,list-compose,list-menu,message-list
action nav.pane::folders
assert-pane folders
assert-accessible window
action nav.pane::reader
assert-pane reader
assert-accessible window
# Back to List (Escape) as the reader's back button says: the list, with the focus in it. The
# focus is in the message's WebView, which hands a key it doesn't use back to the window once
# its web process has answered: a moment later under load, so the checks wait for it.
assert-tooltip reader-back "Back to the list (Escape)"
focus reader
key Escape
wait-until assert-pane list
wait-until assert-focus list
