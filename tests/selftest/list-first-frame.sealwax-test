# The first frame binds only the rows in view (S6's startup trim, ML-026): after every reset the
# list shows at most 64 rows (single-line rows, the Superhuman pass: 38 px, so about 42 fill
# 1600 px), then grows by about 64 rows a frame until GtkListView has realized what it keeps
# (~205 rows); the rest follow in one step without new row widgets. The window waited for the
# first rows at startup, so its first frame already had them. Every message is fictional.
# Run: tools/headless.sh 36 target/debug/pronto --self-test tests/selftest/list-first-frame.sealwax-test

desktop tiling
fixtures --count 2000 --seed 13 --folders single

# Startup: the first view was read ahead with the store; the first frame showed 64 rows.
list-wait
assert-list-growth 64
assert-list-count 2000
assert-list-placeholders 0

# The same on every reset: a tall window, another view, a chip, a search.
resize 1440 1600
folder all-inboxes
assert-list-growth 64
chip unread
assert-list-growth 64
chip all
assert-list-growth 64
search the
assert-list-growth 64
search-escape
assert-list-growth 64
assert-list-count 2000

# Jumping past the rows shown so far shows every row first.
list-select 1999
assert-list-position "2000 of 2000"
assert-list-placeholders 0
