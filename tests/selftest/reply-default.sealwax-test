# Whom the header names and whom the replies answer (issue #8; the fork's phase C). A message to
# the user and others says so in its header ("to me, Tomas, Sana"). Reply (r, Ctrl+R, the card's
# first button, Reply to Sender) answers the sender and Reply All (a, the card's second button)
# everyone, whatever config.toml says. Enter in a conversation (Quick Reply) and the reply box's
# own line answer as [reader] reply says: everyone by default (Superhuman's Enter, the fork's
# default since phase C; it was the sender), the sender with reply = "sender". A change applies
# at once. Each answers under the conversation, in the inline reply (Escape in it, empty, goes
# back). Every name and message is fictional.
# Run: tools/headless.sh 45 target/debug/pronto --self-test tests/selftest/reply-default.sealwax-test

desktop tiling
resize 1440 900
triage-mark-read-on-open false
conversation-account Personal alex.berg@example.test
mail-add Personal:inbox 10m "Middag fredag" read from=Leah "to=Alex Berg <alex.berg@example.test>, Tomas Berg <tomas@example.test>" "cc=Sana Malik <sana@example.test>"
mail-add Personal:inbox 5m "Bare til deg" read from=Ingrid "to=Alex Berg <alex.berg@example.test>"
folder inbox Personal
focus list

# The header names the others besides "me"; a message to the user alone says "to me".
list-select 1
wait-until assert-quick-reply shown true
assert-text-contains reader-recipients "to me, Tomas, Sana"

# By default the box answers everyone, as Enter does: its line names them all.
assert-quick-reply label "Reply to Leah and 2 others"
focus list
action win.quick-reply
assert-quick-reply focused true
assert-quick-reply kind reply-all
assert-quick-reply label "Reply to Leah and 2 others"
key Escape
# Reply answers the sender: the key, Ctrl+R, the card's first button and Reply to Sender.
focus list
key r
assert-quick-reply focused true
assert-quick-reply kind reply
assert-quick-reply label "Reply to Leah"
key Escape
assert-focus-stop message-list
# Closed, the box is Enter's again.
assert-quick-reply kind reply-all
key <Control>r
assert-quick-reply kind reply
key Escape
key a
assert-quick-reply focused true
assert-quick-reply kind reply-all
assert-quick-reply label "Reply to Leah and 2 others"
key Escape
reply-click-card selected reply
assert-quick-reply focused true
assert-quick-reply kind reply
key Escape
reply-click-card selected reply-all
assert-quick-reply kind reply-all
key Escape
action win.reply-sender
assert-quick-reply kind reply
key Escape
assert-compose-requests 0
row-menu 1
assert-row-menu-items "Reply,Reply All,Forward,Archive,Delete,Move to…,Move to Junk,Mark as Unread,Star,!Create Rule from Message…,!Always Junk Messages from Sender,!Never Junk Messages from Sender"
key Escape
wait-until assert-row-menu closed
assert-labelled

# What the box holds goes to the composer as the reply it was.
action win.quick-reply
type "Jeg tar med dessert"
action win.reply-in-composer
assert-compose-last quick-reply selected "Jeg tar med dessert" reply-all
composer-close

# A message to the user alone: everyone is the sender.
focus list
list-select 0
wait-until assert-quick-reply label "Reply to Ingrid"
assert-text-contains reader-recipients "to me"
action win.quick-reply
assert-quick-reply kind reply-all
assert-quick-reply label "Reply to Ingrid"
key Escape

# reply = "sender": Enter and the box answer the sender, applied to the shown message at once;
# r, a, the cards and the menu are as before.
list-select 1
wait-until assert-quick-reply label "Reply to Leah and 2 others"
write-file $TMP/config/pronto/config.toml "[reader]\nreply = \"sender\"\n"
wait-until assert-quick-reply label "Reply to Leah"
assert-text-contains reader-recipients "to me, Tomas, Sana"
focus list
action win.quick-reply
assert-quick-reply kind reply
key Escape
focus list
key r
assert-quick-reply kind reply
key Escape
key a
assert-quick-reply kind reply-all
key Escape
reply-click-card selected reply
assert-quick-reply kind reply
key Escape
reply-click-card selected reply-all
assert-quick-reply kind reply-all
key Escape
# The pop-out above, and no card since.
assert-compose-requests 1
row-menu 1
assert-row-menu-items "Reply,Reply All,Forward,Archive,Delete,Move to…,Move to Junk,Mark as Unread,Star,!Create Rule from Message…,!Always Junk Messages from Sender,!Never Junk Messages from Sender"
key Escape
wait-until assert-row-menu closed

# Back to the default: everyone again.
write-file $TMP/config/pronto/config.toml ""
wait-until assert-quick-reply label "Reply to Leah and 2 others"
focus list
action win.quick-reply
assert-quick-reply kind reply-all
key Escape
